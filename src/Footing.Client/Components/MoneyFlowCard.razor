@using Footing.Client.ViewModels

@if (IsVisible)
{
    <div class="card @(GuidingSentence != null ? "ft-section-card" : "")">
        <div id="@(Name)Heading" class="card-header">
            <h5 class="mb-0">
                @if (GuidingSentence != null)
                {
                    <button class="button btn btn-link btn-accordian-header @(CompactMode ? "ft-compact-header" : "")" type="button" @onclick="ToggleOpen" aria-expanded="@_isOpen.ToString().ToLower()">
                        @Label <MonetaryAmountDisplay Amount="this.MoneyFlows.WeeklyTotalMoneyFlow" /> / Week
                        <span class="ft-chevron" aria-hidden="true">@(_isOpen ? "▼" : "▶")</span>
                    </button>
                }
                else
                {
                    <button class="button btn btn-link btn-accordian-header" type="button" data-bs-toggle="collapse" data-bs-target="#@(Name)Details" aria-expanded="true" aria-controls="@(Name)Details">
                        @Label <MonetaryAmountDisplay Amount="this.MoneyFlows.WeeklyTotalMoneyFlow" /> / Week
                    </button>
                }
            </h5>
        </div>
    </div>
    @if (GuidingSentence != null)
    {
        @if (_isOpen)
        {
            <div id="@(Name)Details" class="ft-section--open" aria-labelledby="@(Name)Heading">
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(GuidingSentence))
                    {
                        <p class="ft-guiding-sentence">@GuidingSentence</p>
                    }

                    <EditForm Model="@Model" OnValidSubmit="AddMoneyFlow">
                        <DataAnnotationsValidator />
                        <dl>
                            <dt>
                                @((MarkupString)FormPrompt)
                            </dt>
                            <dd>
                                $<InputNumber size="10" placeholder="xxx.xx" @bind-Value="Model.Amount" />
                                <InputSelect @bind-Value="Model.Period">
                                    <option value="">how often?</option>
                                    @foreach (Period period in Enum.GetValues(typeof(Period)))
                                    {
                                        <option value="@period">@GetPeriodDescription(period)</option>
                                    }
                                </InputSelect>
                            </dd>
                            <dt>@FormAmountDescriptionConnectorWord</dt>
                            <dd><InputText size="30" placeholder="@($"{Label} Description")" @bind-Value="Model.Name" /></dd>
                        </dl>

                        <button type="submit" class="btn btn-primary">Add</button>
                        <ValidationSummary />
                    </EditForm>

                    @if (this.MoneyFlows.Count > 0)
                    {
                        <table class="table ft-entries-compact">
                            @foreach (var moneyFlow in this.MoneyFlows)
                            {
                                <tr>
                                    <td>@moneyFlow.Name</td>
                                    <td><MonetaryAmountDisplay Amount="@moneyFlow.Amount" /> @moneyFlow.Period</td>
                                    <td><span class="bi bi-x" role="button" @onclick="@(e => this.RemoveMoneyFlow(moneyFlow.Id))"></span></td>
                                </tr>
                            }
                        </table>
                    }

                    @if (OnFirstEntryAdded.HasDelegate)
                    {
                        <div class="ft-skip-link">
                            <a href="" @onclick="SkipSection" @onclick:preventDefault>Skip, move on</a>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div id="@(Name)Details" class="collapse" aria-labelledby="@(Name)Heading" data-bs-parent="#moneyFlows">
            <div class="card-body">
                <table class="table">
                    @foreach (var moneyFlow in this.MoneyFlows)
                    {
                        <tr>
                            <td>@moneyFlow.Name</td>
                            <td><MonetaryAmountDisplay Amount="@moneyFlow.Amount" /> @moneyFlow.Period</td>
                            <td><span class="bi bi-x" role="button" @onclick="@(e => this.RemoveMoneyFlow(moneyFlow.Id))"></span></td>
                        </tr>
                    }
                </table>
                <EditForm Model="@Model" OnValidSubmit="AddMoneyFlow">
                    <DataAnnotationsValidator />
                    <dl>
                        <dt>
                            @((MarkupString)FormPrompt)
                        </dt>
                        <dd>
                            $<InputNumber size="10" placeholder="xxx.xx" @bind-Value="Model.Amount" />
                            <InputSelect @bind-Value="Model.Period">
                                <option value="">how often?</option>
                                @foreach (Period period in Enum.GetValues(typeof(Period)))
                                {
                                    <option value="@period">@GetPeriodDescription(period)</option>
                                }
                            </InputSelect>
                        </dd>
                        <dt>@FormAmountDescriptionConnectorWord</dt>
                        <dd><InputText size="30" placeholder="@($"{Label} Description")" @bind-Value="Model.Name" /></dd>
                    </dl>

                    <button type="submit" class="btn btn-primary">Add</button>
                    <ValidationSummary />
                </EditForm>
            </div>
        </div>
    }
}

@code{
    [Parameter]
    public MoneyFlows MoneyFlows { get; set; } = null!;

    [Parameter]
    public EventCallback<MoneyFlows> MoneyFlowsChanged { get; set; }

    [Parameter]
    public string Name { get; set; } = null!;

    [Parameter]
    public string Label { get; set; } = null!;

    [Parameter]
    public string FormPrompt { get; set; } = null!;

    [Parameter]
    public string FormAmountDescriptionConnectorWord { get; set; } = null!;

    [Parameter]
    public string? GuidingSentence { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public bool IsVisible { get; set; } = true;

    [Parameter]
    public EventCallback OnFirstEntryAdded { get; set; }

    [Parameter]
    public bool CompactMode { get; set; }

    private bool _isOpen;
    private bool _hasNotifiedFirstEntry;
    private bool _initialized;

    private NewMoneyFlowModel Model { get; set; } = new NewMoneyFlowModel();

    protected override void OnParametersSet()
    {
        if (GuidingSentence != null && !_initialized)
        {
            _isOpen = IsOpen;
            if (IsOpen || CompactMode) _initialized = true;
        }
    }

    private void ToggleOpen()
    {
        _isOpen = !_isOpen;
    }

    private async Task AddMoneyFlow()
    {
        this.MoneyFlows.Add(
            new MoneyFlow
            {
                Name = this.Model.Name ?? "",
                Amount = this.Model.Amount ?? default,
                Period = this.Model.Period ?? default,
            });
        this.Model = new NewMoneyFlowModel();
        await this.MoneyFlowsChanged.InvokeAsync(this.MoneyFlows);

        if (!_hasNotifiedFirstEntry && OnFirstEntryAdded.HasDelegate)
        {
            _hasNotifiedFirstEntry = true;
            await OnFirstEntryAdded.InvokeAsync();
        }
    }

    private async Task RemoveMoneyFlow(Guid id)
    {
        var moneyFlow = this.MoneyFlows.First(mf => mf.Id == id);
        this.MoneyFlows.Remove(moneyFlow);
        await this.MoneyFlowsChanged.InvokeAsync(this.MoneyFlows);
    }

    private async Task SkipSection()
    {
        if (OnFirstEntryAdded.HasDelegate)
        {
            _hasNotifiedFirstEntry = true;
            await OnFirstEntryAdded.InvokeAsync();
        }
    }

    private string GetPeriodDescription(Period period) => period switch
    {
        Period.Daily => "every day",
        Period.Weekly => "every week",
        Period.BiWeekly => "every two weeks",
        Period.SemiMonthly => "twice per month",
        Period.Monthly => "every month",
        Period.Quarterly => "every three months",
        Period.SemiAnnually => "every six months",
        Period.Annually => "every year",
        _ => throw new ArgumentException($"Unknown period: {period}"),
    };
}
