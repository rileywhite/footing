@if (this.Amount.IsNegative)
{
    <span class="monetary-amount-highlight monetary-amount-highlight-negative">-$@this.Amount.RoundedAbsoluteAmount</span>
}
else
{
    <span class="monetary-amount-highlight monetary-amount-highlight-positive">$@this.Amount.RoundedAbsoluteAmount</span>
}

@code {
    [Parameter]
    public MonetaryAmount Amount { get; set; }
}
