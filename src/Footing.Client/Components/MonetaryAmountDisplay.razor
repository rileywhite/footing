@if (this.Amount.IsNegative)
{
    <span class="monetary-amount-highlight">-$@this.Amount.RoundedAbsoluteAmount</span>
}
else
{
    <span class="monetary-amount-highlight">$@this.Amount.RoundedAbsoluteAmount</span>
}

@code {
    [Parameter]
    public MonetaryAmount Amount { get; set; }
}
