
@if(this.MoneyFlows.HasFlows)
{
    <table class="table">
        <tr>
            <th scope="col">Source</th>
            <th scope="col">Income</th>
            <th scope="col" />
        </tr>
    @foreach (var inflow in this.MoneyFlows.Inflows)
    { 
        <tr>
            <td>@inflow.Name</td>
            <td><AmountDisplay Amount="@inflow.Amount" /> @inflow.Period</td>
            <td><span class="oi oi-x" @onclick="@(e => this.RemoveInflow(inflow.Name))" ></span></td>
        </tr>
    }
    </table>
}

<MoneyFlowsSummary MoneyFlows="MoneyFlows" />


@code {
    [Parameter]
    public MoneyFlows MoneyFlows { get; set; } = null!;

    private void RemoveInflow(string name)
    {
        var inflow = this.MoneyFlows.Inflows.First(i => i.Name == name);
        this.MoneyFlows.Inflows.Remove(inflow);
    }
}
