@{
    if (this.IsNegative)
    {
       <span>($@this.RoundedAbsoluteAmount)</span>
    }
    else
    {
       <span>$@this.RoundedAbsoluteAmount</span>
    }
}

@code {
    [Parameter]
    public decimal Amount { get; set; }

    public decimal RoundedAbsoluteAmount => Math.Round(Math.Abs(this.Amount), 2);

    public bool IsNegative => this.Amount < 0m;
}
