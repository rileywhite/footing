@inherits LayoutComponentBase

<div class="sidebar">
    <NavMenu />
</div>

<div class="main">
    <div class="top-row px-4 auth">
        <a href="https://www.patreon.com/rileywhite" target="_blank">Support This Tool</a>
        <a href="https://blog.rileywhite.com" target="_blank">About</a>
    </div>

    <div class="content px-4">
        @Body
    </div>
    <div class="alert alert-dismissible text-center cookiealert" role="alert">
