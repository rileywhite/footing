<div>
    @{
        var hasLines = false;
        if (this.MoneyFlows.IsEmpty)
        {
            <span>Start adding your income streams and expenses to see the magic happen!</span>
            hasLines = true;
        }

        if (this.MoneyFlows.HasInflows)
        {
            if (hasLines)
            {
                <br />
            }
            <span>
                Income from @MoneyFlows.Inflows.Count
                source@(MoneyFlows.Inflows.Count == 1 ? "" : "s")
                bring@(MoneyFlows.Inflows.Count == 1 ? "s" : "")
                in a total of <AmountDisplay Amount="MoneyFlows.WeeklyTotalInflow" /> / Week
            </span>
            hasLines = true;
        }

        if (this.MoneyFlows.HasInflows)
        {
            if (hasLines)
            {
                <br />
            }
            <span>
                @MoneyFlows.Outflows.Count expense@(MoneyFlows.Outflows.Count == 1 ? "" : "s")
                cost@(MoneyFlows.Outflows.Count == 1 ? "s" : "")
                you a total of <AmountDisplay Amount="MoneyFlows.WeeklyTotalInflow" /> / Week
            </span>
            hasLines = true;
        }
    }
</div>

@code{
    [Parameter]
    public MoneyFlows MoneyFlows { get; set; } = null!;
}
