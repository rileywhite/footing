@page "/remeter-me"

@inject IJSRuntime JSRuntime

<h1>Remeter My Money</h1>

<p>
    <em>Nothing you put in here will be sent to our servers.</em>
</p>

<div id="moneyFlows" class="accordion">
    <MoneyFlowCard MoneyFlows="@this.RemeterAnalysis.Inflows" Name="income" Label="Income" FormPrompt="@IncomesFormPrompt" />
    <MoneyFlowCard MoneyFlows="@this.RemeterAnalysis.RecurringBills" Name="recurringBills" Label="Recurring Bill" FormPrompt="@RecurringBillsFormPrompt" />
    <MoneyFlowCard MoneyFlows="@this.RemeterAnalysis.HouseholdBudgets" Name="householdBudgets" Label="Household Budget" FormPrompt="@HouseholdBudgetsFormPrompt" />
    <MoneyFlowCard MoneyFlows="@this.RemeterAnalysis.PersonalBudgets" Name="personalBudgets" Label="Personal Budget" FormPrompt="@PersonalBudgetsFormPrompt" />
    <MoneyFlowCard MoneyFlows="@this.RemeterAnalysis.EventBudgets" Name="outgo" Label="Event Budget" FormPrompt="@EventBudgetsFormPrompt" />
</div>
<div class="card">
    <div id="totalHeading" class="card-header">
        <h5>
            <button class="button btn btn-link btn-accordian-header" type="button" data-toggle="collapse" aria-expanded="false">
                Net Total <AmountDisplay Amount="this.RemeterAnalysis.WeeklyTotalMoneyFlow" /> / Week
            </button>
        </h5>
    </div>
</div>


@code {
    private RemeterAnalysis RemeterAnalysis { get; } = new RemeterAnalysis();

    private string IncomesFormPrompt { get; } =
    @"I receive a
    <span data-toggle=""popover"" title=""Final amount deposited into your account after taxes and other garnishments"" data-placement=""auto"" class=""text-info"">
    net amount
    </span>
    of";

    private string RecurringBillsFormPrompt { get; } =
    @"I pay a
    <span data-toggle=""popover"" title=""Same amount every month/year/etc, e.g. phone, internet, auto insurance, groceries, etc"" data-placement=""auto"" class=""text-info"">
    predictable recurring
    </span>
    bill of";

    private string HouseholdBudgetsFormPrompt { get; } =
    @"I estimate that I need to budget a
    <span data-toggle=""popover"" title=""Differring amounts on hard to predict time periods, e.g. $150/quarter for auto maintenance, $100/month for family outings, etc"" data-placement=""auto"" class=""text-info"">
    less predictable shared amount
    </span>
    of";

    private string PersonalBudgetsFormPrompt { get; } =
    @"I estimate that I, or someone in my household, needs to budget
    <span data-toggle=""popover"" title=""For a personal spending allowance, haircut, eating lunch at work, etc"" data-placement=""auto"" class=""text-info"">
    a personally available
    </span>
    amount of";

    private string EventBudgetsFormPrompt { get; } =
    @"I estimate that I need to create a budget for a
    <span data-toggle=""popover"" title=""Differring amounts on strictly or loosely occuring time periods, e.g. Christmas, Birthdays, vacations, etc"" data-placement=""auto"" class=""text-info"">
    recurring event
    </span>
    of";

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InitializePopovers();
        await base.OnAfterRenderAsync(firstRender);
    }
}
