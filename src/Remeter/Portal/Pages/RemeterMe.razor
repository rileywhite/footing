@page "/remeter-me"

@inject IJSRuntime JSRuntime

<h1>Remeter My Money</h1>

<p>
    <em>Nothing you put in here will be sent to our servers.</em>
</p>

<div id="moneyFlows" class="accordion">
    <MoneyFlowCard MoneyFlows="@this.RemeterAnalysis.Inflows" Name="income" Label="Income" />
</div>


@code {
    private RemeterAnalysis RemeterAnalysis { get; } = new RemeterAnalysis();

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InitializePopovers();
        await base.OnAfterRenderAsync(firstRender);
    }
}
