@inherits LayoutComponentBase

<div class="sidebar">
    <NavMenu />
</div>

<div class="main">
    <SupportNavMenu />
    <div class="content px-4">
        @Body
    </div>
    <div class="alert alert-dismissible text-center cookiealert" role="alert">
        <div class="cookiealert-container">
            <hr width="25%" />
            <p>
                Do you accept that <b>we use cookies</b> to ensure you get the best experience on our website?
            </p>
            <p>
                <a href="http://cookiesandyou.com/" target="_blank">Learn more</a>
            </p>

            <button type="button" class="btn btn-primary btn-sm acceptcookies" data-dismiss="alert" aria-label="Close">
                I accept
            </button>
        </div>
    </div>
</div>
