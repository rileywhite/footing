@using Blazored.LocalStorage
@using Remeter.Portal.Shared
@using System.IO

@inject IJSInterop JSInterop
@inject IBlazorPrerenderDetector PrerenderDetector
@inject ISyncLocalStorageService LocalStore

<p>
    <em>
        Nothing you put in here will be sent to our servers. It will be saved to your local computer; however, you may
        <a href="" @onclick=ClearLocalStorage @onclick:preventDefault>clear</a>
        it at any time.
    </em>
</p>

<div id="moneyFlows" class="accordion">
    <MoneyFlowCard @bind-MoneyFlows=this.RemeterAnalysis.Inflows
                   Name="income"
                   Label="Income"
                   FormPrompt="@IncomesFormPrompt"
                   FormAmountDescriptionConnectorWord="from" />
    <MoneyFlowCard @bind-MoneyFlows=this.RemeterAnalysis.RecurringBills
                   Name="recurringBills"
                   Label="Recurring Bill"
                   FormPrompt="@RecurringBillsFormPrompt"
                   FormAmountDescriptionConnectorWord="for" />
    <MoneyFlowCard @bind-MoneyFlows=this.RemeterAnalysis.HouseholdBudgets
                   Name="householdBudgets"
                   Label="Household Budget"
                   FormPrompt="@HouseholdBudgetsFormPrompt"
                   FormAmountDescriptionConnectorWord="for" />
    <MoneyFlowCard @bind-MoneyFlows=this.RemeterAnalysis.PersonalBudgets
                   Name="personalBudgets"
                   Label="Personal Budget"
                   FormPrompt="@PersonalBudgetsFormPrompt"
                   FormAmountDescriptionConnectorWord="for" />
    <MoneyFlowCard @bind-MoneyFlows=this.RemeterAnalysis.EventBudgets
                   Name="eventBudgets"
                   Label="Event Budget"
                   FormPrompt="@EventBudgetsFormPrompt"
                   FormAmountDescriptionConnectorWord="for" />
    <div class="card @MonetaryAmount.AmountSensitiveCssClass">
        <div id="totalHeading" class="card-header">
            <h5>
                <button class="button btn btn-link btn-accordian-header" type="button" data-toggle="collapse" data-target="#totalDetails" aria-expanded="true" aria-controls="totalDetails">
                    Net Total <MonetaryAmountDisplay Amount=@NetTotalWeeklyAmount /> / Week
                </button>
            </h5>
        </div>
        <div id="totalDetails" class="collapse" aria-labelledby="totalHeading" data-parent="#moneyFlows">
            <div class="card-body">
                @if (this.NetTotalWeeklyAmount.IsNegative)
                {
                    <h5>
                        <span class="oi oi-wrench"></span> Time to roll up your sleeves
                    </h5>
                    <p>
                        It's a good time to take a hard look at your expenses. It's no fun, but with hard work, you can pull yourself back into the
                        net positive territory!
                    </p>
                }
                else
                {
                    <h5>
                        <span class="oi oi-badge"></span> You're looking good so far
                    </h5>
                    <p>
                        This could always change as you notice new expenses that you aren't yet tracking and as unexpected expenses
                        appear. It's a good idea to stash your extra money somewhere where it will earn interest.
                    </p>
                }
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <input type="button" class="btn btn-primary" @onclick="ExportToExcel" value="Download Excel Spreadsheet" />
        </div>
    </div>
</div>

@code {
    private static string RemeterAnalysisStorageKey = "3794bdc6-f064-43e6-9a1e-8bb2c03d16cb";

    public RemeterAnalysis RemeterAnalysis { get; set; } = null!;

    public void UpdateLocalStorage()
    {
        this.LocalStore.SetItem(RemeterAnalysisStorageKey, this.RemeterAnalysis);
    }

    public async Task ClearLocalStorage()
    {
        if (await this.JSInterop.Confirm("This will clear all information that you have entered so far. Proceed?"))
        {
            this.RemeterAnalysis = new RemeterAnalysis();
            this.LocalStore.Clear();
        }
    }

    private MonetaryAmount NetTotalWeeklyAmount => this.RemeterAnalysis.WeeklyTotalMoneyFlow;

    private string IncomesFormPrompt { get; } =
    @"I receive a
<span data-toggle=""popover"" title=""Final amount deposited into your account after taxes and other garnishments"" data-placement=""auto"" class=""text-info"">
net amount
</span>
of";

    private string RecurringBillsFormPrompt { get; } =
    @"I pay a
<span data-toggle=""popover"" title=""Same amount every month/year/etc, e.g. phone, internet, auto insurance, groceries, etc"" data-placement=""auto"" class=""text-info"">
predictable recurring
</span>
bill of";

    private string HouseholdBudgetsFormPrompt { get; } =
    @"I estimate that I need to budget a
<span data-toggle=""popover"" title=""Differring amounts on hard to predict time periods, e.g. $150/quarter for auto maintenance, $100/month for family outings, etc"" data-placement=""auto"" class=""text-info"">
less predictable shared amount
</span>
of";

    private string PersonalBudgetsFormPrompt { get; } =
    @"I estimate that someone in my household needs to budget a
<span data-toggle=""popover"" title=""For a personal spending allowance, haircut, eating lunch at work, etc"" data-placement=""auto"" class=""text-info"">
personally available
</span>
amount of";

    private string EventBudgetsFormPrompt { get; } =
    @"I estimate that I need a
<span data-toggle=""popover"" title=""Differring amounts on strictly or loosely occuring time periods, e.g. Christmas, Birthdays, vacations, etc"" data-placement=""auto"" class=""text-info"">
recurring event
</span>
budget of";

    private async Task ExportToExcel()
    {
        using var stream = new MemoryStream();

        await new SimplexcelExporter(this.RemeterAnalysis).ExportTo(stream);

        await this.JSInterop.DownloadAs(stream, "Remeter Me.xlsx", ExcelXslXFile);
    }

    protected override void OnInitialized()
    {
        if (!this.PrerenderDetector.IsPrerendering)
        {
            this.RemeterAnalysis = this.LocalStore.GetItem<RemeterAnalysis>(RemeterAnalysisStorageKey) ?? new RemeterAnalysis();
            this.RemeterAnalysis?.FixVersionIssues();

            if (this.RemeterAnalysis == null)
            {
                this.RemeterAnalysis = new RemeterAnalysis();
            }
        }
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!this.PrerenderDetector.IsPrerendering)
        {
            if (firstRender)
            {
                await this.JSInterop.InitializePopovers();
            }
            else
            {
                this.UpdateLocalStorage();
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }
}
