@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a href="https://www.buymeacoffee.com/rileywhite" target="_blank">
                        <img src="https://cdn.buymeacoffee.com/buttons/v2/default-green.png" alt="Buy Me A Coffee"
                             style="height: 30px !important;width: 163px !important;" />
                    </a>
                </li>
                <li class="nav-item ms-3">
                    <a href="https://www.patreon.com/rileywhite" target="_blank">Become a Patron</a>
                </li>
                <li class="nav-item ms-3">
                    <a href="https://blog.rileywhite.com/tag/footing/" target="_blank">Learn More</a>
                </li>
            </ul>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#x1f5d9;</span>
</div>
